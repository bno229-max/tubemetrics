rules_version = '2';

// O Firestore do TubeMetrics guarda apenas o histórico diário dos canais:
// a coleção `tracked` (quem é monitorado) e `snapshots` (o retrato de cada dia).
//
// Nada disso é lido pelo navegador. Quem escreve e lê é a Serverless Function
// da Vercel, usando a conta de serviço do Admin SDK — que passa POR CIMA destas
// regras por definição. Portanto negar tudo aqui não é um "TODO": é a
// configuração correta e final para esta etapa.
//
// Se um dia o front for ler Firestore direto, este arquivo precisa mudar junto,
// e aí a regra tem que checar autenticação e plano do usuário.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
